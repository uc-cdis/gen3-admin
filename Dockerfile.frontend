ARG AZLINUX_BASE_VERSION=master

# For local development
FROM quay.io/cdis/amazonlinux-base:${AZLINUX_BASE_VERSION}


# Node 22, the current LTS line. The base image's default `nodejs` package is
# 18, which Next 16 refuses (it wants >= 20.9), so the version has to be named
# explicitly -- the ENV NODE_VERSION that used to sit here had no effect on
# what yum installed, it was only a label.
RUN yum install -y unzip nodejs22 nodejs22-npm && \
    ln -sf /usr/bin/node-22 /usr/bin/node && \
    ln -sf /usr/bin/npm-22 /usr/bin/npm

WORKDIR /frontend

ARG NEXT_PUBLIC_BOOTSTRAP_MODE
ENV NEXT_PUBLIC_BOOTSTRAP_MODE=${NEXT_PUBLIC_BOOTSTRAP_MODE}

ARG API_BASE_URL
ENV API_BASE_URL=${API_BASE_URL}

# Datadog RUM / Session Replay. NEXT_PUBLIC_* values are inlined into the
# browser bundle by `npm run build` below, so they must be passed as build args
# (docker build --build-arg ...); setting them at container runtime has no
# effect. RUM stays off unless both the application ID and client token are set.
# See frontend/lib/datadog.js for defaults.
ARG NEXT_PUBLIC_DD_RUM_APPLICATION_ID
ARG NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN
ARG NEXT_PUBLIC_DD_SITE
ARG NEXT_PUBLIC_DD_SERVICE
ARG NEXT_PUBLIC_DD_ENV
ARG NEXT_PUBLIC_DD_VERSION
ARG NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE
ARG NEXT_PUBLIC_DD_SESSION_REPLAY_SAMPLE_RATE
ARG NEXT_PUBLIC_DD_PROXY
ENV NEXT_PUBLIC_DD_RUM_APPLICATION_ID=${NEXT_PUBLIC_DD_RUM_APPLICATION_ID} \
    NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=${NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN} \
    NEXT_PUBLIC_DD_SITE=${NEXT_PUBLIC_DD_SITE} \
    NEXT_PUBLIC_DD_SERVICE=${NEXT_PUBLIC_DD_SERVICE} \
    NEXT_PUBLIC_DD_ENV=${NEXT_PUBLIC_DD_ENV} \
    NEXT_PUBLIC_DD_VERSION=${NEXT_PUBLIC_DD_VERSION} \
    NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE=${NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE} \
    NEXT_PUBLIC_DD_SESSION_REPLAY_SAMPLE_RATE=${NEXT_PUBLIC_DD_SESSION_REPLAY_SAMPLE_RATE} \
    NEXT_PUBLIC_DD_PROXY=${NEXT_PUBLIC_DD_PROXY}

COPY ./frontend/package.json ./frontend/package-lock.json /frontend/
RUN npm install

# RUN curl -fsSL https://bun.sh/install | bash

# ENV PATH="/root/.bun/bin:$PATH"

# RUN bun install

COPY ./frontend /frontend

RUN npm run build

# FROM amazonlinux:2023 AS final

# RUN yum update -y && yum install -y nodejs

# WORKDIR /app

# COPY --from=go-builder /go/src/gen3-admin-api/bin/gen3-admin-api /app/
# COPY gen3-admin-api/.env /app/
# COPY --from=nextjs-builder /frontend /app/frontend

# COPY start.sh /app/

# RUN chmod +x /app/start.sh

EXPOSE 3000

# CMD ["node", ".next/standalone/server.js"]
CMD ["npm", "start"]
