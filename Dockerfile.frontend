ARG AZLINUX_BASE_VERSION=master

# For local development
FROM quay.io/cdis/amazonlinux-base:${AZLINUX_BASE_VERSION}


# Node 22, the current LTS line. The base image's default `nodejs` package is
# 18, which Next 16 refuses (it wants >= 20.9), so the version has to be named
# explicitly -- the ENV NODE_VERSION that used to sit here had no effect on
# what yum installed, it was only a label.
RUN yum install -y unzip nodejs22 nodejs22-npm && \
    ln -sf /usr/bin/node-22 /usr/bin/node && \
    ln -sf /usr/bin/npm-22 /usr/bin/npm

WORKDIR /frontend

ARG NEXT_PUBLIC_BOOTSTRAP_MODE
ENV NEXT_PUBLIC_BOOTSTRAP_MODE=${NEXT_PUBLIC_BOOTSTRAP_MODE}

ARG API_BASE_URL
ENV API_BASE_URL=${API_BASE_URL}

COPY ./frontend/package.json ./frontend/package-lock.json /frontend/
RUN npm install

# RUN curl -fsSL https://bun.sh/install | bash

# ENV PATH="/root/.bun/bin:$PATH"

# RUN bun install

COPY ./frontend /frontend

RUN npm run build

# FROM amazonlinux:2023 AS final

# RUN yum update -y && yum install -y nodejs

# WORKDIR /app

# COPY --from=go-builder /go/src/gen3-admin-api/bin/gen3-admin-api /app/
# COPY gen3-admin-api/.env /app/
# COPY --from=nextjs-builder /frontend /app/frontend

# COPY start.sh /app/

# RUN chmod +x /app/start.sh

EXPOSE 3000

# CMD ["node", ".next/standalone/server.js"]
CMD ["npm", "start"]
