# Copy into frontend/.env.local (gitignored) for local dev, or pass each as
# --build-arg to `docker build -f Dockerfile.frontend` for images.
# Values are baked in at build/dev-server start; restart `next dev` after editing.
#
# From Datadog (gov): Digital Experience > Real User Monitoring > Manage
# Applications > <your app> > Application ID / Client Token.

NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=

# US1-FED. Leave as-is for Datadog for Government.
NEXT_PUBLIC_DD_SITE=ddog-gov.com

NEXT_PUBLIC_DD_SERVICE=csoc
NEXT_PUBLIC_DD_ENV=dev
# NEXT_PUBLIC_DD_VERSION=

# Percent of sessions tracked, and of those, percent recorded for replay.
NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE=100
NEXT_PUBLIC_DD_SESSION_REPLAY_SAMPLE_RATE=100

# Optional: your own intake proxy URL, if ad blockers drop sessions.
# NEXT_PUBLIC_DD_PROXY=
