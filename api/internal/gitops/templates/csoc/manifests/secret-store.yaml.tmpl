# Every ExternalSecret in this cluster reads from here. The ESO controller's
# own IRSA role does the reading, and it can only read gen3-csoc/{{ .Name }}/*.
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: {{ .SecretStore }}
spec:
  provider:
    aws:
      service: SecretsManager
      region: {{ q .Region }}
