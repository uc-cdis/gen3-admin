# The CSOC's own secrets. Each was generated into Secrets Manager by the
# bootstrap; rotate them there and ESO updates these within the hour.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: keycloak-admin-credentials
spec:
  refreshInterval: 1h
  secretStoreRef: {kind: ClusterSecretStore, name: {{ .SecretStore }}}
  target: {name: keycloak-admin-credentials}
  dataFrom:
    - extract: {key: {{ q (secret . "keycloak-admin") }}}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: csoc-keycloak-client
spec:
  refreshInterval: 1h
  secretStoreRef: {kind: ClusterSecretStore, name: {{ .SecretStore }}}
  target: {name: csoc-keycloak-client}
  dataFrom:
    - extract: {key: {{ q (secret . "keycloak-client") }}}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: csoc-nextauth
spec:
  refreshInterval: 1h
  secretStoreRef: {kind: ClusterSecretStore, name: {{ .SecretStore }}}
  target: {name: csoc-nextauth}
  dataFrom:
    - extract: {key: {{ q (secret . "nextauth") }}}
