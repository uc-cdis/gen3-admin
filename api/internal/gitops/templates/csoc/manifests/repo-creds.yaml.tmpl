# ArgoCD's login to this repo: the GitHub App's ID, installation ID and key,
# from Secrets Manager. Only the names are here.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: gitops-repo-creds
  namespace: argocd
spec:
  refreshInterval: 1h
  secretStoreRef: {kind: ClusterSecretStore, name: {{ .SecretStore }}}
  target:
    name: gitops-repo-creds
    template:
      metadata:
        labels:
          argocd.argoproj.io/secret-type: repo-creds
      data:
        type: git
        url: {{ q .Repo.URLPrefix }}
        githubAppID: "{{"{{"}} .app_id {{"}}"}}"
        githubAppInstallationID: "{{"{{"}} .installation_id {{"}}"}}"
        githubAppPrivateKey: "{{"{{"}} .private_key {{"}}"}}"
  dataFrom:
    - extract: {key: {{ q (secret . "github-app") }}}
